{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!vendor",
            "!node_modules",
            "!.claude",
            "!.agents",
            "!.grok",
            "!public",
            "!bootstrap/ssr",
            "!storage",
            "!resources/js/actions",
            "!resources/js/routes",
            "!resources/js/wayfinder",
            "!resources/js/components/ui",
            "!registry.json",
            "!resources/js/hooks/use-media-query.ts",
            "!resources/js/lib/segmented-control.ts",
            "!resources/views/mail",
            "!**/*.yml",
            "!**/*.yaml",
            "!composer.json",
            "!composer.lock",
            "!bun.lock",
            "!skills-lock.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "useEditorconfig": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "off"
            },
            "style": {
                "useBlockStatements": "error",
                "useImportType": {
                    "level": "error",
                    "options": {
                        "style": "separatedType"
                    }
                }
            },
            "nursery": {
                "useSortedClasses": {
                    "level": "error",
                    "fix": "safe",
                    "options": {
                        "functions": ["clsx", "cn", "cva"],
                        "attributes": ["class", "className"]
                    }
                }
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSameLine": false,
            "bracketSpacing": true
        }
    }
}
